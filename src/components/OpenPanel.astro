---
const OPENPANEL_CLIENT_ID = "landing-page-4771";
---

<!-- OpenPanel Analytics -->
<script is:inline define:vars={{ OPENPANEL_CLIENT_ID }}>
  window.op = window.op || function () {
    const queue = [];

    return new Proxy(function () {
      if (arguments.length) {
        queue.push([].slice.call(arguments));
      }
    }, {
      get: function (_target, key) {
        return key === "q"
          ? queue
          : function () {
              queue.push([key].concat([].slice.call(arguments)));
            };
      },
      has: function (_target, key) {
        return key === "q";
      },
    });
  }();

  window.op("init", {
    clientId: OPENPANEL_CLIENT_ID,
    trackScreenViews: true,
    trackOutgoingLinks: true,
    trackAttributes: true,
  });
</script>
<script is:inline src="https://openpanel.dev/op1.js" defer async></script>
